# Oriđiđi — optional API keys. EVERYTHING here is optional: the system must work
# fully with local models alone (master prompt §15). Copy to .env and fill only
# what you use. .env is gitignored; never commit real keys.

# Anthropic — modern_holdout generation + opt-in LLM-judge only (spend-capped)
ANTHROPIC_API_KEY=

# Hugging Face read token (needed only for gated models; none of the M0-verified
# models are gated)
HF_TOKEN=

# Free-tier providers for the modern_holdout set (M3)
GOOGLE_API_KEY=
GROQ_API_KEY=

# Optional extras
OPENAI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
